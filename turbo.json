{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "pipeline": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_DEFAULT_CHAIN_ID",
        "NEXT_PUBLIC_WALLET_CONNECT_ID",
        "NEXT_PUBLIC_INFURA_API_TOKEN",
        "NEXT_PUBLIC_ALCHEMY_API_KEY",
        "NEXT_PUBLIC_GIT_ID",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_MAINNET",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_ARBITRUM",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_SEPOLIA",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_HARDHAT",
        "NEXT_PUBLIC_ENV",
        "IRON_SESSION_COOKIE_NAME",
        "IRON_SESSION_PASSWORD",
        "NODE_ENV",
        "_AWS_REGION",
        "_AWS_ACCESS_KEY_ID",
        "_AWS_SECRET_ACCESS_KEY",
        "_AWS_DYNAMO_TABLE_NAME",
        "ALCHEMY_API_KEY",
        "INFURA_API_TOKEN",
        "NEXT_PUBLIC_LOCAL_DISTRIBUTOR_ADDRESS",
        "NEXT_PUBLIC_LOCAL_FACTORY_ADDRESS",
        "NEXT_PUBLIC_LOCAL_LINK_ADDRESS",
        "NEXT_PUBLIC_LOCAL_ROUTER_ADDRESS",
        "NEXT_PUBLIC_LOCAL_WETH_ADDRESS",
        "NEXT_PUBLIC_LOCAL_YMWK_ADDRESS",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_ARBITRUM",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_ARBITRUM_SEPOLIA",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_BASE",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_BASE_SEPOLIA",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_HARDHAT",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_MAINNET",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_2_SEPOLIA",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_ARBITRUM_SEPOLIA",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_BASE",
        "NEXT_PUBLIC_SUBGRAPH_ENDPOINT_BASE_SEPOLIA",
        "NEXT_PUBLIC_SUPPOTED_CHAIN_IDS"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
